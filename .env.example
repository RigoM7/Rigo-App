# Everything is optional for local development.
# Without DATABASE_URL, Rigo stores data in an embedded PostgreSQL (PGlite) under ./data/db.
# DATABASE_URL=postgres://user:password@localhost:5432/rigo
# PORT=8787
# APP_URL=http://localhost:5173          # used to build invitation/reset links
# STORAGE_DRIVER=local                    # local (./data/uploads) or database
# RIGO_DEV_MAILBOX=1                      # show simulated emails at /dev/mailbox (local only; default on outside production)
# RIGO_TRUST_PROXY=1                      # trust X-Forwarded-For for client addresses (automatic on Vercel; only behind a proxy that sets it)

# Account recovery and legal links (shown only when set; nothing is invented):
# RIGO_SUPPORT_EMAIL=help@example.com      # shown on "Forgot your password?" for owners with no other owner
# RIGO_TERMS_URL=https://example.com/terms # linked at sign-up with RIGO_PRIVACY_URL
# RIGO_PRIVACY_URL=https://example.com/privacy

# Optional external services stay disabled until configured:
# RIGO_EMAIL_PROVIDER=                     # account email service (no provider implemented yet; reset, invitation and
#                                          # confirmation emails all go through it once one is added)
# RIGO_AI_PROVIDER=anthropic               # enables real AI for real (non-demo) companies
# ANTHROPIC_API_KEY=
# RIGO_AI_MODEL=claude-sonnet-5-5
# RIGO_AI_DAILY_LIMIT=50                   # assistant requests per company per day
